{
  "name": "lucy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "clean": "node scripts/clean.mjs",
    "commit": "cz",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@lucy/backend",
    "dev:frontend": "turbo run dev --filter=@lucy/frontend",
    "format": "prettier --cache --write --ignore-unknown .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "standard-version",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "latest",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.15.47",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-dom": "^5.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-react-x": "^5.18.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^13.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "standard-version": "^9.5.0",
    "supertest": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.5.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "turbo": "^2.10.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
