{
  "name": "lucy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "clean": "node scripts/clean.mjs",
    "commit": "cz",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@lucy/backend",
    "dev:frontend": "turbo run dev --filter=@lucy/frontend",
    "format": "prettier --cache --write --ignore-path .gitignore --ignore-unknown .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "release": "standard-version",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.18.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^13.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.5.22",
    "standard-version": "^9.5.0",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
