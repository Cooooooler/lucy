# 复制为 .env 后按实际环境修改
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lucy

# Redis 连接配置（含 RedisBloom 模块）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 配置
JWT_SECRET=<生成随机串，如 openssl rand -hex 32>
JWT_EXPIRES_IN=15m
REFRESH_TTL_SECONDS=604800
# refresh token 超过该毫秒数才轮换（默认 600000=10 分钟），降低多标签页竞态
REFRESH_ROTATION_MS=600000
# 复用检测宽限期（秒）：轮换后短时间内旧 token 再现视为良性，超过才判定泄露
REUSE_GRACE_SECONDS=10

# 布隆过滤器（登录设备去重）配置
BLOOM_ERROR_RATE=0.01
BLOOM_CAPACITY=1000000
BLOOM_ROTATION_SECONDS=900

# AI 对话（Ollama + LangChain）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 模型生成空闲超时（毫秒）：持续无输出超过该时长判为超时，默认 120000
OLLAMA_TIMEOUT_MS=120000
AI_CONTEXT_TOKEN_LIMIT=4096
AI_CONTEXT_RESERVE_RATIO=0.7
AI_SYSTEM_PROMPT=
AI_TITLE_PROMPT=为这段对话生成一个不超过20字的简短标题，只输出标题本身：

# 日志（Pino，经 nestjs-pino 集成；请求级 x-request-id 关联）
LOG_LEVEL=info
# LOG_PRETTY=1 时控制台输出美化日志（默认仅开发环境非 production 时美化）
LOG_PRETTY=1
