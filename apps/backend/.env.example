# 复制为 .env 后按实际环境修改
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lucy

# Redis 连接配置（含 RedisBloom 模块）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 配置
JWT_SECRET=<生成随机串，如 openssl rand -hex 32>
JWT_EXPIRES_IN=15m
REFRESH_TTL_SECONDS=604800
# refresh token 超过该毫秒数才轮换（默认 600000=10 分钟），降低多标签页竞态
REFRESH_ROTATION_MS=600000
# 复用检测宽限期（秒）：轮换后短时间内旧 token 再现视为良性，超过才判定泄露
REUSE_GRACE_SECONDS=10

# 布隆过滤器（登录设备去重）配置
BLOOM_ERROR_RATE=0.01
BLOOM_CAPACITY=1000000
BLOOM_ROTATION_SECONDS=900

# AI 对话（Ollama + LangChain）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 模型生成空闲超时（毫秒）：持续无输出超过该时长判为超时，默认 120000
OLLAMA_TIMEOUT_MS=120000
# 输入上下文预算（token）：扣除安全边际后为单轮历史+系统提示+本次消息的可用总额
AI_CONTEXT_TOKEN_LIMIT=131072
# 安全边际（token）：本地 tokenizer 估算/模板/特殊 token 未计满时的防御量，防止贴边越界
AI_CONTEXT_SAFETY_MARGIN=2048
# 生成输出上限（token）：作为 num_predict 传给模型，即「给生成内容预留的空间」
AI_OUTPUT_MAX_TOKENS=32768
AI_SYSTEM_PROMPT=
AI_TITLE_PROMPT=为这段对话生成一个不超过20字的简短标题，只输出标题本身：

# 日志（Pino，经 nestjs-pino 集成）
# LOG_LEVEL=info 级别的日志；请求级 x-request-id/x-trace-id 作为 traceId 关联整条链路（req.id）
LOG_LEVEL=info
# LOG_PRETTY=1 时控制台输出美化日志（默认仅开发环境非 production 时美化）
LOG_PRETTY=1
# 本地开发阶段除控制台外，另落盘 JSON 日志到 apps/backend/logs/backend-YYYY-MM-DD.log（.gitignore 已忽略），
# 按日期分文件，每条含 req.id（traceId），可用 grep traceId 检索单次请求完整链路；production 不落盘

# 知识库文件存储
FILE_STORAGE=local
# 文件大小上限（字节），默认 10485760（10MB）
FILE_MAX_SIZE=10485760
# 本地存储根目录，默认 uploads
UPLOAD_DIR=uploads
