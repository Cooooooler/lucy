{
  "name": "@lucy/backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "db:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "db:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/db/data-source.ts",
    "dev": "nest start --watch",
    "gen:openapi": "vitest run --config vitest.gen.config.ts",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coool/redis-nest": "workspace:*",
    "@langchain/core": "^1.2.5",
    "@langchain/ollama": "^1.3.0",
    "@lucy/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@scalar/nestjs-api-reference": "^1.2.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "catalog:",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  }
}
