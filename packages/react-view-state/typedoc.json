{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "entryFileName": "index.md",
  "mergeReadme": false,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "indexFormat": "table",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "validation": {
    "notExported": true,
    "invalidLink": true
  }
}
