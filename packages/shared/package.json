{
  "name": "@lucy/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm --clean --dts --watch --tsconfig tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "typegen": "openapi-typescript ../../apps/backend/openapi.json -o src/generated/openapi.ts && node scripts/ensure-eslint-disable.mjs"
  }
}
