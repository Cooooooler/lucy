{
  "name": "@coool/redis-nest",
  "version": "0.1.0",
  "description": "NestJS Redis integration module: connection management, serialization, DI, multi-source, unified errors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --dts --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --clean --dts --watch --tsconfig tsconfig.build.json",
    "docs:api": "typedoc",
    "docs:build": "pnpm run docs:api && vitepress build docs",
    "docs:dev": "pnpm run docs:api && vitepress dev docs",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" --max-warnings 0",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "ioredis": "catalog:",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "ioredis": "^5.11.1"
  }
}
